            "ref": "ORDER_CONFIRMATION",
            "subject": "Your {{ company|default:\"eNotifier\" }} order #{{ order_number }} is confirmed",
            "body": "<!doctype html>\n<html lang=\"en\" xmlns=\"http://www.w3.org/1999/xhtml\" xmlns:v=\"urn:schemas-microsoft-com:vml\" xmlns:o=\"urn:schemas-microsoft-com:office:office\">\n  <head>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\n    <meta name=\"x-apple-disable-message-reformatting\">\n    <meta name=\"format-detection\" content=\"telephone=no, date=no, address=no, email=no\">\n    <meta name=\"color-scheme\" content=\"light\">\n    <meta name=\"supported-color-schemes\" content=\"light\">\n    <title>Order confirmation</title>\n    <!--[if mso]>\n    <noscript><xml><o:OfficeDocumentSettings><o:PixelsPerInch>96</o:PixelsPerInch></o:OfficeDocumentSettings></xml></noscript>\n    <![endif]-->\n    <style>\n      html,body{margin:0 auto !important;padding:0 !important;height:100% !important;width:100% !important;background:#f1f5f9;}\n      *{-ms-text-size-adjust:100%;-webkit-text-size-adjust:100%;}\n      table,td{mso-table-lspace:0pt !important;mso-table-rspace:0pt !important;border-collapse:collapse !important;}\n      img{-ms-interpolation-mode:bicubic;border:0;height:auto;line-height:100%;outline:none;text-decoration:none;}\n      a{text-decoration:none;}\n      a[x-apple-data-detectors]{color:inherit !important;text-decoration:none !important;font-size:inherit !important;font-family:inherit !important;font-weight:inherit !important;line-height:inherit !important;}\n      .ExternalClass{width:100%;}\n      .ExternalClass,.ExternalClass p,.ExternalClass span,.ExternalClass font,.ExternalClass td,.ExternalClass div{line-height:100%;}\n      @media only screen and (max-width:600px){\n        .email-container{width:100% !important;margin:0 auto !important;}\n        .px{padding-left:20px !important;padding-right:20px !important;}\n      }\n    </style>\n  </head>\n  <body width=\"100%\" style=\"margin:0;padding:0 !important;mso-line-height-rule:exactly;background-color:#f1f5f9;\">\n    <div style=\"display:none;font-size:1px;line-height:1px;max-height:0;max-width:0;opacity:0;overflow:hidden;mso-hide:all;\">Thanks for your order - here's your receipt.&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;</div>\n    <div role=\"article\" aria-roledescription=\"email\" aria-label=\"Order confirmation\" lang=\"en\" style=\"background-color:#f1f5f9;\">\n      <table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"background-color:#f1f5f9;\">\n        <tr>\n          <td align=\"center\" style=\"padding:24px 12px;\">\n            <!--[if mso | IE]><table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" align=\"center\" width=\"600\"><tr><td><![endif]-->\n            <table role=\"presentation\" class=\"email-container\" align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"max-width:600px;margin:0 auto;background:#ffffff;border-radius:12px;overflow:hidden;border:1px solid #e2e8f0;\">\n              <tr>\n                <td class=\"px\" bgcolor=\"#4f46e5\" style=\"background:#4f46e5;padding:20px 32px;\">\n                  <span style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#ffffff;font-size:20px;font-weight:700;letter-spacing:-0.02em;\">{{ company|default:\"eNotifier\" }}</span>\n                </td>\n              </tr>\n              <tr>\n                <td class=\"px\" style=\"padding:32px;\">\n                <h1 style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;margin:0 0 16px;color:#0f172a;font-size:24px;font-weight:700;letter-spacing:-0.02em;\">Thanks for your order, {{ name }}!</h1>\n                <p style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;margin:0 0 16px;color:#334155;font-size:15px;line-height:1.6;\">Your order <strong>#{{ order_number }}</strong> is confirmed and being prepared. Here's a summary:</p>\n                <table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"margin:8px 0 20px;border:1px solid #e2e8f0;border-radius:10px;\">\n                  <tr bgcolor=\"#f8fafc\">\n                    <th align=\"left\" style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;padding:10px 16px;color:#64748b;font-size:12px;text-transform:uppercase;letter-spacing:0.05em;font-weight:600;\">Item</th>\n                    <th align=\"center\" style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;padding:10px 16px;color:#64748b;font-size:12px;text-transform:uppercase;letter-spacing:0.05em;font-weight:600;\">Qty</th>\n                    <th align=\"right\" style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;padding:10px 16px;color:#64748b;font-size:12px;text-transform:uppercase;letter-spacing:0.05em;font-weight:600;\">Price</th>\n                  </tr>\n                  {% for item in items %}\n                  <tr>\n                    <td style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;padding:12px 16px;color:#0f172a;font-size:14px;border-top:1px solid #e2e8f0;\">{{ item.name }}</td>\n                    <td align=\"center\" style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;padding:12px 16px;color:#475569;font-size:14px;border-top:1px solid #e2e8f0;\">{{ item.qty }}</td>\n                    <td align=\"right\" style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;padding:12px 16px;color:#0f172a;font-size:14px;border-top:1px solid #e2e8f0;\">{{ item.price }}</td>\n                  </tr>\n                  {% endfor %}\n                  <tr bgcolor=\"#f8fafc\">\n                    <td colspan=\"2\" style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;padding:12px 16px;color:#0f172a;font-size:15px;font-weight:700;border-top:2px solid #e2e8f0;\">Total</td>\n                    <td align=\"right\" style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;padding:12px 16px;color:#0f172a;font-size:15px;font-weight:700;border-top:2px solid #e2e8f0;\">{{ order_total }}</td>\n                  </tr>\n                </table>\n                <p style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;margin:0 0 16px;color:#334155;font-size:15px;line-height:1.6;\"><strong>Shipping to:</strong><br>{{ shipping_address }}</p>\n                <table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin:24px 0;\"><tr><td align=\"center\" bgcolor=\"#4f46e5\" style=\"border-radius:8px;background:#4f46e5;mso-padding-alt:14px 28px;\"><a href=\"{{ track_url }}\" target=\"_blank\" style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;display:inline-block;padding:14px 28px;font-size:15px;line-height:20px;font-weight:bold;color:#ffffff;text-decoration:none;border-radius:8px;\">Track your order</a></td></tr></table>\n                </td>\n              </tr>\n              <tr>\n                <td class=\"px\" bgcolor=\"#f8fafc\" style=\"padding:20px 32px;background:#f8fafc;border-top:1px solid #e2e8f0;\">\n                  <p style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;margin:0;color:#94a3b8;font-size:12px;line-height:1.6;\">\n                    You are receiving this email from {{ company|default:\"eNotifier\" }}.<br>\n                    Need help? Contact <a href=\"mailto:{{ support_email|default:'support@example.com' }}\" style=\"color:#6366f1;text-decoration:none;\">{{ support_email|default:\"support@example.com\" }}</a>.\n                  </p>\n                </td>\n              </tr>\n            </table>\n            <!--[if mso | IE]></td></tr></table><![endif]-->\n            <p style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;margin:16px 0 0;color:#cbd5e1;font-size:11px;\">Sent with eNotifier</p>\n          </td>\n        </tr>\n      </table>\n    </div>\n  </body>\n</html>",
            "addon_data": null,
