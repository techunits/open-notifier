ight-rule:exactly;background-color:#f1f5f9;\">\n    <div style=\"display:none;font-size:1px;line-height:1px;max-height:0;max-width:0;opacity:0;overflow:hidden;mso-hide:all;\">The latest updates, curated for you.&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;</div>\n    <div role=\"article\" aria-roledescription=\"email\" aria-label=\"Newsletter\" lang=\"en\" style=\"background-color:#f1f5f9;\">\n      <table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"background-color:#f1f5f9;\">\n        <tr>\n          <td align=\"center\" style=\"padding:24px 12px;\">\n            <!--[if mso | IE]><table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" align=\"center\" width=\"600\"><tr><td><![endif]-->\n            <table role=\"presentation\" class=\"email-container\" align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"max-width:600px;margin:0 auto;background:#ffffff;border-radius:12px;overflow:hidden;border:1px solid #e2e8f0;\">\n              <tr>\n                <td class=\"px\" bgcolor=\"#4f46e5\" style=\"background:#4f46e5;padding:20px 32px;\">\n                  <span style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#ffffff;font-size:20px;font-weight:700;letter-spacing:-0.02em;\">{{ company|default:\"eNotifier\" }}</span>\n                </td>\n              </tr>\n              <tr>\n                <td class=\"px\" style=\"padding:32px;\">\n                <p style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;margin:0 0 8px;color:#6366f1;font-size:13px;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;\">{{ edition|default:\"This week\" }}</p>\n                <h1 style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;margin:0 0 16px;color:#0f172a;font-size:24px;font-weight:700;letter-spacing:-0.02em;\">{{ headline }}</h1>\n                <p style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;margin:0 0 16px;color:#334155;font-size:15px;line-height:1.6;\">Hi {{ name }}, here's what's new at {{ company|default:\"eNotifier\" }}.</p>\n                <p style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;margin:0 0 16px;color:#334155;font-size:15px;line-height:1.6;\">{{ intro }}</p>\n                <table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"margin:8px 0 24px;border:1px solid #e2e8f0;border-radius:10px;\">\n                  <tr><td style=\"padding:20px;\">\n                    <h2 style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;margin:0 0 8px;color:#0f172a;font-size:18px;font-weight:700;\">{{ article_title }}</h2>\n                    <p style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;margin:0 0 12px;color:#475569;font-size:14px;line-height:1.6;\">{{ article_summary }}</p>\n                    <a href=\"{{ article_url }}\" style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#4f46e5;font-size:14px;font-weight:600;text-decoration:none;\">Read more &rarr;</a>\n                  </td></tr>\n                </table>\n                <p style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;margin:0;color:#94a3b8;font-size:13px;line-height:1.6;\">\n                  Don't want these updates? <a href=\"{{ unsubscribe_url }}\" style=\"color:#94a3b8;text-decoration:underline;\">Unsubscribe</a>.\n                </p>\n                </td>\n              </tr>\n              <tr>\n                <td class=\"px\" bgcolor=\"#f8fafc\" style=\"padding:20px 32px;background:#f8fafc;border-top:1px solid #e2e8f0;\">\n                  <p style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;margin:0;color:#94a3b8;font-size:12px;line-height:1.6;\">\n                    You are receiving this email from {{ company|default:\"eNotifier\" }}.<br>\n                    Need help? Contact <a href=\"mailto:{{ support_email|default:'support@example.com' }}\" style=\"color:#6366f1;text-decoration:none;\">{{ support_email|default:\"support@example.com\" }}</a>.\n                  </p>\n                </td>\n              </tr>\n            </table>\n            <!--[if mso | IE]></td></tr></table><![endif]-->\n            <p style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;margin:16px 0 0;color:#cbd5e1;font-size:11px;\">Sent with eNotifier</p>\n          </td>\n        </tr>\n      </table>\n    </div>\n  </body>\n</html>",
